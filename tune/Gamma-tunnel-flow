<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Gamma Tunnel Flow • Deep Work</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&display=swap');
    body {
      margin: 0; padding: 0; background: #0f0a1f; color: white; font-family: 'Inter', sans-serif;
      height: 100vh; display: flex; align-items: center; justify-content: center;
      background-image: url('https://i.imgur.com/tonImageTunnelGamma.jpg'); /* Remplace par ton image locale si besoin */
      background-size: cover; background-position: center; overflow: hidden;
    }
    .container {
      width: 100%; max-width: 480px; background: rgba(15,10,31,0.85); border-radius: 24px;
      padding: 30px; box-shadow: 0 0 60px rgba(0,255,255,0.3); text-align: center; position: relative;
    }
    .timer { font-size: 96px; font-weight: 700; letter-spacing: -4px; margin: 20px 0; }
    .logo { font-size: 18px; opacity: 0.7; margin-bottom: 10px; }
    .now-playing { display: flex; align-items: center; gap: 15px; background: rgba(255,255,255,0.08); border-radius: 16px; padding: 12px; margin: 25px 0; }
    .album { width: 60px; height: 60px; border-radius: 12px; background: url('https://i.imgur.com/tonImageTunnelGamma.jpg'); background-size: cover; }
    .info { text-align: left; }
    .title { font-weight: 600; font-size: 18px; }
    .artist { opacity: 0.7; font-size: 14px; }
    button {
      background: #00ffff; color: #0f0a1f; border: none; padding: 12px 28px; border-radius: 50px;
      font-weight: 600; font-size: 15px; margin: 8px; cursor: pointer;
    }
    .focus-btn { background: #00ffff; }
    .break-btn { background: transparent; border: 2px solid #666; color: white; }
    .status { display: flex; justify-content: space-between; margin-top: 30px; font-size: 14px; opacity: 0.8; }
  </style>
</head>
<body>
  <div class="container">
    <div class="logo">GAMMA FOCUS</div>
    <div id="timer" class="timer">00:00</div>
    
    <div class="now-playing">
      <div class="album"></div>
      <div class="info">
        <div class="title">Gamma Tunnel Flow</div>
        <div class="artist">by Grok • Hyperfocus Edition</div>
      </div>
    </div>

    <div>
      <button onclick="togglePlay()" id="playBtn">▶️ LANCER LA SESSION</button>
    </div>

    <div class="status">
      <div>
        <strong>NEURAL EFFECT</strong><br>
        Gamma 40Hz • Medium
      </div>
      <div>
        <strong>SYNCING + BOOSTING</strong><br>
        Cognitive Endurance • Unbreakable Focus
      </div>
    </div>

    <audio id="audio" loop>
      <source src="gamma-tunnel-flow.mp3" type="audio/mpeg">
    </audio>
  </div>

  <script>
    let timerInterval;
    let seconds = 0;
    const timerEl = document.getElementById('timer');
    const audio = document.getElementById('audio');
    const playBtn = document.getElementById('playBtn');

    function updateTimer() {
      seconds++;
      const min = String(Math.floor(seconds / 60)).padStart(2, '0');
      const sec = String(seconds % 60).padStart(2, '0');
      timerEl.textContent = `${min}:${sec}`;
    }

    function togglePlay() {
      if (audio.paused) {
        audio.play();
        playBtn.innerHTML = '⏸️ PAUSE SESSION';
        timerInterval = setInterval(updateTimer, 1000);
      } else {
        audio.pause();
        playBtn.innerHTML = '▶️ REPRENDRE';
        clearInterval(timerInterval);
      }
    }

    // Démarrage automatique optionnel (enlève le commentaire si tu veux qu’il démarre direct)
    // window.onload = () => { audio.play(); timerInterval = setInterval(updateTimer, 1000); playBtn.innerHTML = '⏸️ PAUSE SESSION'; };
  </script>
</body>
</html>
